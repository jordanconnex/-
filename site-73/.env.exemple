# Variables du serveur du Site-73.
# En ligne : Netlify → ton site → Site configuration → Environment variables.
# En local : copie ce fichier en « .env » (jamais envoyé sur GitHub) puis « npm run dev ».
# Ne mets JAMAIS les vraies valeurs dans ce fichier-ci ni dans le dépôt.

# Longue chaîne aléatoire (au moins 32 caractères) qui signe les sessions — à cocher « secret » sur Netlify
SESSION_SECRET=

# Administrateur principal : il se connecte avec cet identifiant et ce mot de passe,
# puis nomme les autres administrateurs depuis la console staff.
# Identifiant : 3 à 20 caractères (lettres sans accent, chiffres, . _ -)
ADMIN_IDENTIFIANT=
# Mot de passe de l'administrateur principal (8 caractères minimum) — à cocher « secret » sur Netlify
ADMIN_MOT_DE_PASSE=

# Facultatif mais conseillé : code à donner sur le Discord pour pouvoir créer un compte.
# Vide = n'importe qui peut créer un compte (au niveau par défaut) — à cocher « secret » sur Netlify
CODE_INSCRIPTION=

# Facultatif : habilitation d'un nouveau compte (1 par défaut)
HABILITATION_PAR_DEFAUT=1
