// Déploiement Cloudflare du Site-73 (Workers + fichiers statiques).
// Sur Cloudflare : Workers & Pages → Create → Import a repository,
// « Root directory » = site73. Le reste est lu ici.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site73",
  "main": "serveur/worker.mjs",
  "compatibility_date": "2026-06-01",

  // Les 14 pages, le CSS et le JavaScript du site
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },

  // Stockage des membres, de l'alerte, des communiqués, des événements et du journal.
  // Sans « id », Cloudflare crée l'espace KV tout seul au premier déploiement.
  // Si tu l'as créé toi-même (Storage & Databases → KV), ajoute : "id": "<son identifiant>"
  "kv_namespaces": [
    { "binding": "SITE73" }
  ],

  // Garde les variables réglées dans le tableau de bord à chaque déploiement
  "keep_vars": true,

  "observability": { "enabled": true }
}
